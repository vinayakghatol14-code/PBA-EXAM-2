Q1.Question: Write a Python program using the csv module to read employee attendance records from attendance.csv. Count the total number of attendance records for each employee, then display an employee attendance report showing each employee’s name and total attendance days.

import csv

attendance = {}

with open("attendance.csv", "r", newline="", encoding="utf-8") as file:
    reader = csv.DictReader(file)

    for row in reader:
        name = row["Employee"].strip()

        if name:
            attendance[name] = attendance.get(name, 0) + 1

print("Employee Attendance Report")
print("---------------------------")

for name, days in attendance.items():
    print(f"{name}: {days} days")
